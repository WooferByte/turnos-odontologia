# Configuración de ejemplo para desarrollo local (design I11).
# TODOS los valores son de prueba y ficticios (RN-PR-01): no uses credenciales reales.
# Copiá este archivo a .env (que no se versiona) y Docker Compose lo lee solo.
# Python NO lee .env: las variables comentadas se definen en la terminal.

# Imagen oficial de PostgreSQL: estos nombres los exige la imagen.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=turnos

# Para correr algo desde tu máquina contra el contenedor (puerto 5434 del host):
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5434/turnos
# Solo para el perfil opcional de tests (python -m pytest -m postgres):
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5434/turnos_test
